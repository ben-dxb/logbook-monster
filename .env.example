# Copy to .env and fill in. Never commit .env – it holds your secrets.

# Long random string that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# The address people open in their browser (no trailing slash).
# Local testing: http://localhost:3000   Server: https://meals.example.com
BASE_URL=http://localhost:3000
PORT=3000
# HOST=127.0.0.1          # defaults to 127.0.0.1 locally, 0.0.0.0 when NODE_ENV=production

# Google sign-in (optional). Create an OAuth client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add this redirect URI:
#   <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may have an account.
# ALLOWED_EMAILS: comma-separated. If set, ONLY these addresses can sign in, and they can
# create their own account (password or Google) the first time.
ALLOWED_EMAILS=
# ALLOW_REGISTRATION=true lets anyone sign up. Leave false for a private app.
ALLOW_REGISTRATION=false

# Where the SQLite database lives.
# DB_PATH=./data/mealswap.db

# Behind a reverse proxy (nginx, Caddy, Traefik) in production keep TRUST_PROXY=1.
# NODE_ENV=production
# TRUST_PROXY=1
# COOKIE_SECURE=true      # defaults to true when BASE_URL starts with https://
# SESSION_DAYS=30
