# Copy to .env and fill in. Never commit .env – it holds your secrets.

# Long random strings that sign session cookies: newest first, all accepted (docs/rotation.md). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Put the day it was set in front, so Super admin › Keys knows its age:  SESSION_SECRETS=2026-10-17:<secret>
# (SESSION_SECRET=… still works for a single one.)
SESSION_SECRETS=
# Recommended: the key that wraps the sealed secrets in the database, and the key for the security log's email hash.
# While rotating SEAL_KEY, put the previous one in SEAL_KEY_OLD for one start.
# SEAL_KEY=2026-10-17:<secret>
# SEAL_KEY_OLD=
# AUDIT_HASH_KEY=

# The address people open in their browser (no trailing slash).
# Local testing: http://localhost:3000   Server: https://meals.example.com
BASE_URL=http://localhost:3000
PORT=3000
# HOST=127.0.0.1          # defaults to 127.0.0.1 locally, 0.0.0.0 when NODE_ENV=production

# Google sign-in (optional). Create an OAuth client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add this redirect URI:
#   <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may have an account.
# ALLOWED_EMAILS: comma-separated. If set, ONLY these addresses can sign in, and they can
# create their own account (password or Google) the first time.
ALLOWED_EMAILS=
# ALLOW_REGISTRATION=true lets anyone sign up. Leave false for a private app.
ALLOW_REGISTRATION=false

# Where the SQLite database lives (a relative path is taken from the folder the server starts in),
# and the progress photo files (default: photos/ next to the database).
# DB_PATH=./data/logbook-monster.db
# PHOTO_DIR=./data/photos

# Behind a reverse proxy (nginx, Caddy, Traefik) set TRUST_PROXY=1 (docker-compose.yml already does).
# Leave it unset without a proxy: then a client could fake its address with X-Forwarded-For.
# NODE_ENV=production
# TRUST_PROXY=1
# COOKIE_SECURE=true      # defaults to true when BASE_URL starts with https://
# SESSION_DAYS=30

# Who can open the Super admin page (AI key, people, email, options, security log).
# Comma-separated. Required when NODE_ENV=production (the server won't start without it);
# on a local setup, leave it empty and the first account ever created is the admin.
# ADMIN_EMAILS=you@example.com

# AI features (optional): plan, workout and supplement reads, food values, photo poses, exercise body parts,
# the Timeline summary. You can also add the key on the
# Super admin page instead; a key saved there wins over this one. Get one at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Sending email (invites, notifications). Easiest is to fill this in on the Super admin page (Email);
# settings saved there win over these. For Gmail use an app password
# (https://myaccount.google.com/apppasswords), not your normal password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# MAIL_FROM=you@gmail.com
# MAIL_FROM_NAME=Logbook Monster
# SMTP_SECURE=true        # TLS from the start; defaults to true on port 465, else STARTTLS
# The mail server must be on the internet: private, loopback and link-local addresses are refused, and
# on a port other than 465 it must offer STARTTLS. List a local relay here to allow it anyway:
# SMTP_ALLOW_HOSTS=127.0.0.1

# Who runs this app, shown on the privacy page (/privacy) and as the Contact link on the sign-in page and account menu.
# Without PRIVACY_CONTACT the privacy page says to ask the person who runs the app, and there is no Contact link –
# unless SHOW_ADMIN_CONTACT=true, which offers the first ADMIN_EMAILS address instead.
# PRIVACY_CONTACT=privacy@example.com
# OPERATOR_NAME=Jo Bloggs
# SHOW_ADMIN_CONTACT=false
